#!/usr/bin/env python3
"""nodict — offline Norwegian<->English dictionary lookup.

  nodict hund            # auto: finds 'hund' on either side -> dog
  nodict dog             # -> hund
  nodict "rød vin"       # multiword
  nodict -s tran         # -s: prefix/substring suggestions when unsure

Backed by dict.sqlite (Apertium nor-eng). Offline, instant, zero-budget.
"""
import argparse, sqlite3, sys
from pathlib import Path

DB = Path(__file__).resolve().parent / "dict.sqlite"
POS = {"n":"noun","np":"proper noun","vblex":"verb","adj":"adj","adv":"adv",
       "pr":"prep","prn":"pron","cnjcoo":"conj","cnjsub":"conj","ij":"interj",
       "num":"num","det":"det","part":"part"}


def pretty(p):
    return POS.get(p, p) if p else ""


def lookup(con, word):
    w = word.strip().lower()
    no2en = con.execute(
        "SELECT DISTINCT no,no_pos,en,en_pos FROM pair WHERE no_lc=? ORDER BY en", (w,)).fetchall()
    en2no = con.execute(
        "SELECT DISTINCT en,en_pos,no,no_pos FROM pair WHERE en_lc=? ORDER BY no", (w,)).fetchall()
    return no2en, en2no


def suggest(con, word, limit=25):
    w = word.strip().lower()
    rows = con.execute(
        "SELECT DISTINCT no FROM pair WHERE no_lc LIKE ? UNION "
        "SELECT DISTINCT en FROM pair WHERE en_lc LIKE ? LIMIT ?",
        (w + "%", w + "%", limit)).fetchall()
    return [r[0] for r in rows]


def main():
    ap = argparse.ArgumentParser(description="Offline Norwegian<->English dictionary")
    ap.add_argument("word", nargs="+", help="word or phrase to look up")
    ap.add_argument("-s", "--suggest", action="store_true",
                    help="show prefix suggestions instead of exact lookup")
    args = ap.parse_args()
    word = " ".join(args.word)

    if not DB.exists():
        sys.exit(f"no database at {DB} — run build.py first")
    con = sqlite3.connect(DB)

    if args.suggest:
        hits = suggest(con, word)
        print("\n".join(hits) if hits else f"(no words starting with '{word}')")
        return

    no2en, en2no = lookup(con, word)
    if not no2en and not en2no:
        hits = suggest(con, word)
        print(f"'{word}' not found.")
        if hits:
            print("did you mean: " + ", ".join(hits[:12]))
        sys.exit(1)

    if no2en:
        print(f"🇳🇴 {word}")
        for no, nop, en, enp in no2en:
            tag = f"  [{pretty(nop)}]" if nop else ""
            print(f"   → {en}{('  ('+pretty(enp)+')') if enp else ''}{tag}")
    if en2no:
        print(f"🇬🇧 {word}")
        for en, enp, no, nop in en2no:
            tag = f"  [{pretty(enp)}]" if enp else ""
            print(f"   → {no}{('  ('+pretty(nop)+')') if nop else ''}{tag}")


if __name__ == "__main__":
    main()
