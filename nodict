#!/usr/bin/env python3
"""nodict — slim offline Norwegian<->English dictionary + active-vocab drills.

  nodict glissen          # NO->EN: spread out, not crowded
  nodict sparse           # EN->NO: glissen, spredt
  nodict "rød vin"        # multiword
  nodict --throw 5        # 5 random words/idioms from your word-of-day list
  nodict --throw 5 -k idiom   # only phrases/idioms

Data (plain JSON, hand-editable):
  dict.json       — the dictionary (Wiktionary depth, basics trimmed)
  wordofday.json  — your active-vocabulary target list (from Beeminder)
"""
import argparse, json, random, sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
DICT = HERE / "dict.json"
WOD  = HERE / "wordofday.json"


def load_dict():
    if not DICT.exists():
        sys.exit(f"no dictionary at {DICT} — run build.py")
    return json.loads(DICT.read_text(encoding="utf-8"))


def show_lookup(word):
    d = load_dict()
    w = word.strip().lower()
    hit = False
    e = d["no2en"].get(w)
    if e:
        hit = True
        pos = f" ({e['pos']})" if e.get("pos") else ""
        print(f"\033[1m{e['word']}\033[0m{pos}  🇳🇴→🇬🇧")
        for g in e["en"]:
            print(f"   {g}")
    e = d["en2no"].get(w)
    if e:
        hit = True
        print(f"\033[1m{e['word']}\033[0m  🇬🇧→🇳🇴")
        print("   " + ", ".join(e["no"]))
    if not hit:
        # prefix suggestions
        sug = [k for k in list(d["no2en"]) + list(d["en2no"]) if k.startswith(w)][:12]
        print(f"'{word}' not found.")
        if sug:
            print("did you mean: " + ", ".join(sorted(set(sug))))
        sys.exit(1)


def throw(n, kind):
    if not WOD.exists():
        sys.exit(f"no word-of-day list at {WOD} — run ingest-wordofday.py")
    items = json.loads(WOD.read_text(encoding="utf-8"))
    if kind == "idiom":
        items = [i for i in items if i["kind"] == "phrase"]
    elif kind == "word":
        items = [i for i in items if i["kind"] == "word"]
    if not items:
        sys.exit("no matching items in your word-of-day list")
    for i in random.sample(items, min(n, len(items))):
        flag = "🇳🇴" if i["lang"] == "no" else "🇬🇧"
        print(f"  {flag}  {i['text']}")


def main():
    ap = argparse.ArgumentParser(description="Norwegian<->English dictionary + vocab drills")
    ap.add_argument("word", nargs="*", help="word or phrase to look up")
    ap.add_argument("-t", "--throw", type=int, metavar="N",
                    help="serve N random items from your word-of-day list")
    ap.add_argument("-k", "--kind", choices=["word", "idiom", "any"], default="any",
                    help="with --throw: restrict to words or idioms/phrases")
    args = ap.parse_args()

    if args.throw is not None:
        throw(args.throw, args.kind)
        return
    if not args.word:
        ap.print_help()
        return
    show_lookup(" ".join(args.word))


if __name__ == "__main__":
    main()
